# 1. 默认屏蔽根目录下的所有内容 (终极黑名单)
/*

# 2. 仅“开绿灯”放行我们需要的内容 (白名单)
!/.gitignore
!/netgen/
!/test_code_expansion/
!/.vscode/

# ====================================================
# 3. 在“开了绿灯”的目录中，再次过滤掉编译产物和临时文件
# ====================================================

# 全局通用过滤 (编译垃圾)
*.o
*.so
*.a
*.pyc
__pycache__/
*.exe
*.log
*.tmp

# netgen 内部的编译/安装目录过滤 (如果有)
/netgen/build/
/netgen/install/

# test_code_expansion 内部过滤
/test_code_expansion/build/
/test_code_expansion/result/
/test_code_expansion/err/
/test_code_expansion/inputData/
/test_code_expansion/install-test/

# ====================================================
# strong_scaling_results：保留可复现实验与故障诊断文本，忽略大体积中间产物
# ====================================================
/test_code_expansion/strong_scaling_results/**/application_output/
/test_code_expansion/strong_scaling_results/**/rank_profiles.jsonl
/test_code_expansion/strong_scaling_results/**/rank_profiles.jsonl.gz
/test_code_expansion/strong_scaling_results/**/run.log.gz
/test_code_expansion/strong_scaling_results/**/.run.lock
/test_code_expansion/strong_scaling_results/**/RUNNING
/test_code_expansion/strong_scaling_results/**/SUCCESS
/test_code_expansion/strong_scaling_results/**/mesh/
/test_code_expansion/strong_scaling_results/**/verify_*/
/test_code_expansion/strong_scaling_results/**/launcher_logs/
/test_code_expansion/strong_scaling_results/**/scheduler_logs/
/test_code_expansion/strong_scaling_results/**/page_cache_logs/
/test_code_expansion/strong_scaling_results/**/build_logs/
/test_code_expansion/strong_scaling_results/**/*.out
/test_code_expansion/strong_scaling_results/**/*.err

# 覆盖全局 *.log 规则：实验诊断日志需要提交，便于直接定位失败原因
!/test_code_expansion/strong_scaling_results/**/run.log
!/test_code_expansion/strong_scaling_results/**/failures.log
!/test_code_expansion/strong_scaling_results/**/job-*.log

# 节点协作验证的精简诊断文件始终保留
!/test_code_expansion/strong_scaling_results/**/node_coop_errors.txt
