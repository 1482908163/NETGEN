build/
result/
inputData/
install-test/
err/
*.o
*.pyc
__pycache__/
*.so
*.a
*.exe
*.tmp
.vscode/

# General logs: keep ordinary logs ignored, then explicitly allow experiment diagnostics.
*.log

# Strong-scaling large outputs
strong_scaling_results/**/application_output/
strong_scaling_results/**/rank_profiles.jsonl
strong_scaling_results/**/rank_profiles.jsonl.gz
strong_scaling_results/**/run.log.gz
strong_scaling_results/**/.run.lock
strong_scaling_results/**/RUNNING
strong_scaling_results/**/SUCCESS
strong_scaling_results/**/mesh/
strong_scaling_results/**/verify_*/
strong_scaling_results/**/launcher_logs/
strong_scaling_results/**/scheduler_logs/
strong_scaling_results/**/page_cache_logs/
strong_scaling_results/**/build_logs/
strong_scaling_results/**/*.out
strong_scaling_results/**/*.err

# Diagnostics required by the current node-cooperation validation.
!strong_scaling_results/**/run.log
!strong_scaling_results/**/failures.log
!strong_scaling_results/**/job-*.log
!strong_scaling_results/**/node_coop_errors.txt
!strong_scaling_results/**/node_coop_stderr.txt

# 精简结果规则须位于本目录放行规则之后，避免覆盖根目录的忽略设置。
strong_scaling_results/**/run.log
strong_scaling_results/**/run.log.gz
strong_scaling_results/**/node_coop_diagnostics.txt
strong_scaling_results/**/node_coop_stderr.txt
strong_scaling_results/**/analysis/node_resource_timeline.csv
strong_scaling_results/**/analysis/model_samples.csv
strong_scaling_results/**/analysis/model_samples.csv.gz
strong_scaling_results/**/quality_summary.json
strong_scaling_results/**/.node_scaling.lock

# 精简指标、故障摘要和必要诊断可上传；失败原始日志仍保留在超算磁盘。
!strong_scaling_results/**/analysis_metrics.json
!strong_scaling_results/**/failure_summary.txt
!strong_scaling_results/**/node_coop_errors.txt

# 整批规则搜索汇总使用的并发锁。
strong_scaling_results/**/.rule_search_batch.lock
